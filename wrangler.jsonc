{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protestmate",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
