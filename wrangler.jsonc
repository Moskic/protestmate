{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protestmate",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "80731427",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
